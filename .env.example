# ===== 应用 =====
APP_ENV=development
# MVP 全局时区：所有用户统一按此时区计算临期/过期日期
APP_TIMEZONE=Asia/Shanghai
# 必须替换为强随机值（例如 openssl rand -hex 32）；留空或保留占位符会导致服务拒绝启动
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# 本机直跑后端用 localhost；compose 容器内由 deploy/docker-compose.yml 覆盖为 db:5432
DATABASE_URL=postgresql+psycopg://pantry:pantry@localhost:5432/pantrypilot
# Only for pytest: must point to a separate pantrypilot_test database, never pantrypilot.
TEST_DATABASE_URL=
# Only for committed-concurrency test cleanup; use the separate maintenance role.
TEST_MAINTENANCE_DATABASE_URL=
CORS_ORIGINS=http://localhost:5200,http://localhost

# ===== 模型 API（仅服务端可见，禁止进入前端） =====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# ===== 前端公开变量（VITE_ 前缀，编译进产物，禁止放密钥） =====
VITE_API_BASE=/api/v1
