# =============================================================
# PantryPilot 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
#   · .env 在仓库根目录，不会被提交（已在 .gitignore）
#   · SECRET_KEY 保留占位符会导致后端拒绝启动（有意为之）
#   · 容器内运行时 DATABASE_URL 等由 deploy/docker-compose.yml 覆盖为 db:5432
# =============================================================

# ---------- 应用 ----------
APP_ENV=development
# 临期/过期状态按该时区的“今天”计算
APP_TIMEZONE=Asia/Shanghai
# 必须替换为强随机值（例如 openssl rand -hex 32）；留空或保留占位符会导致服务拒绝启动
SECRET_KEY=change-me-to-a-long-random-string

# ---------- 令牌 ----------
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- 数据库 ----------
# 宿主机直连用 localhost；compose 容器内自动覆盖为 db:5432
DATABASE_URL=postgresql+psycopg://pantry:pantry@localhost:5432/pantrypilot
# pytest 专用，数据库名必须是 pantrypilot_test（测试夹具会强制校验，绝不能指向开发库）
TEST_DATABASE_URL=postgresql+psycopg://pantry:pantry@localhost:5432/pantrypilot_test
# 测试维护账号（可选）：填写后才能运行需要清理并发的 2 个测试，未填写时它们会自动跳过
# 账号需先用 scripts/provision-test-maintenance-role.sql 创建，密码请填本地自定值
TEST_MAINTENANCE_DATABASE_URL=

# ---------- PostgreSQL 容器参数（deploy/docker-compose.yml 使用） ----------
POSTGRES_USER=pantry
POSTGRES_PASSWORD=pantry
POSTGRES_DB=pantrypilot
POSTGRES_TEST_DB=pantrypilot_test
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=80

# ---------- 跨域 ----------
# 前端开发服务器默认 5200；多个来源用逗号分隔
CORS_ORIGINS=http://localhost:5200,http://localhost

# ---------- 模型 API（仅服务端可见，禁止进入前端） ----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# ---------- 前端公开变量（VITE_ 前缀，编译进产物，禁止放密钥） ----------
VITE_API_BASE=/api/v1
